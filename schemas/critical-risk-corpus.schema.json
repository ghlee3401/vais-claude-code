{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vais.local/schemas/critical-risk-corpus.schema.json",
  "title": "VAIS Critical Risk Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "labelPolicy",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "critical-risk"
    },
    "cases": {
      "type": "array",
      "minItems": 26,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "category",
          "minimumAssurance",
          "requiredTrigger",
          "requiredChecks",
          "requiresSecurityDialogue",
          "split",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^risk-[0-9]{2}$"
          },
          "summary": {
            "type": "string",
            "minLength": 8,
            "pattern": "^(?!.*(?:AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,})).*$"
          },
          "category": {
            "enum": [
              "auth",
              "authorization",
              "payment",
              "pii",
              "migration",
              "destructive",
              "regulated",
              "external-write",
              "secret",
              "dependency",
              "infrastructure",
              "untrusted-input",
              "agent-capability"
            ]
          },
          "minimumAssurance": {
            "enum": [
              "high",
              "regulated"
            ]
          },
          "requiredTrigger": {
            "enum": [
              "auth",
              "authorization",
              "payment",
              "pii",
              "health",
              "regulated",
              "cross-border",
              "migration",
              "external-write",
              "secret",
              "dependency",
              "infrastructure",
              "destructive",
              "untrusted-input",
              "agent-capability"
            ]
          },
          "requiredChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "acceptance-test",
                "accessibility-test",
                "analytics-test",
                "architecture-review",
                "auth-test",
                "authorization-test",
                "backup-restore-test",
                "build",
                "capacity-test",
                "compatibility-test",
                "compliance-review",
                "configuration-test",
                "contract-test",
                "credential-test",
                "data-flow-review",
                "data-integrity-test",
                "data-residency-review",
                "dependency-scan",
                "dry-run",
                "e2e-test",
                "event-contract-test",
                "failover-test",
                "failure-recovery-test",
                "financial-control-test",
                "hook-diff-review",
                "idempotency-test",
                "injection-test",
                "input-validation-test",
                "integration-test",
                "lint",
                "migration-dry-run",
                "negative-test",
                "path-safety-test",
                "payment-test",
                "performance-test",
                "pii-scan",
                "pipeline-test",
                "privacy-review",
                "prompt-injection-test",
                "publisher-review",
                "rate-limit-test",
                "recovery-drill",
                "regression-test",
                "retention-test",
                "rollback-test",
                "rotation-check",
                "rto-rpo-test",
                "sandbox-test",
                "secret-scan",
                "security-review",
                "size-type-limit-test",
                "supply-chain-scan",
                "tamper-test",
                "tenant-isolation-test",
                "tool-allowlist-test",
                "ui-test",
                "unit-test",
                "visual-regression"
              ]
            },
            "uniqueItems": true
          },
          "requiresSecurityDialogue": {
            "const": true
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "labeler"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending-external",
                  "approved",
                  "changes-requested"
                ]
              },
              "labeler": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "split": {
            "const": "held-out"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "category": {
                  "const": "auth"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "auth"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "authorization"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "authorization"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "payment"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "payment"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "pii"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "pii"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "migration"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "migration"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "destructive"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "destructive"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "regulated"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "regulated"
                },
                "minimumAssurance": {
                  "const": "regulated"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "external-write"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "external-write"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "secret"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "secret"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "dependency"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "dependency"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "infrastructure"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "infrastructure"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "untrusted-input"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "untrusted-input"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": {
                  "const": "agent-capability"
                }
              }
            },
            "then": {
              "properties": {
                "requiredTrigger": {
                  "const": "agent-capability"
                },
                "minimumAssurance": {
                  "const": "high"
                }
              }
            }
          }
        ]
      }
    },
    "labelPolicy": {
      "type": "string",
      "minLength": 1
    }
  }
}
