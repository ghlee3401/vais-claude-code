{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vais.local/schemas/ledger-entry.schema.json",
  "title": "VAIS v2 Ledger Entry",
  "description": "One append-only line of .vais/v2/ledger.jsonl. Written only by the runtime at state transitions; never edited.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "ts", "workItemId", "feature", "kind", "text", "why", "source", "refs"],
  "properties": {
    "schema": { "const": "ledger-entry/v1" },
    "id": { "type": "string", "pattern": "^LG-[0-9a-f-]{36}$" },
    "ts": { "type": "string", "format": "date-time" },
    "workItemId": { "type": ["string", "null"], "pattern": "^WI-\\d{4}-\\d{2}-\\d{2}-[a-z0-9-]+$" },
    "feature": { "type": ["string", "null"], "maxLength": 120 },
    "kind": { "enum": ["milestone", "decision", "feedback", "preference", "debt", "risk", "note"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 400 },
    "why": { "type": "string", "maxLength": 400 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["transaction", "event", "user", "hook"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "refs": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
