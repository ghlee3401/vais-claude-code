{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vais.local/schemas/chain-stage.schema.json",
  "title": "VAIS chain stage catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productRoot", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "productRoot": { "type": "string", "pattern": "^docs/[a-z0-9-]+$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "title", "idPrefix", "file", "requiredFields", "parents", "coverage", "owner", "specialists", "choose", "confirm", "approvalPhrase"],
        "properties": {
          "id": { "type": "string", "pattern": "^stage-[a-z0-9-]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "title": { "type": "string", "minLength": 1 },
          "idPrefix": { "type": "string", "pattern": "^[A-Z]{1,4}$" },
          "file": { "type": "string", "pattern": "^docs/[a-z0-9-]+/[0-9]{2}-[a-z0-9-]+\\.md$" },
          "artifactDir": { "type": "string", "pattern": "^docs/[a-z0-9-]+/[a-z0-9-]+$" },
          "artifactFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "renderArtifacts": { "type": "boolean" },
          "documentSections": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "requiredFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "parents": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required", "allowed"],
            "properties": {
              "required": { "type": "boolean" },
              "allowed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{1,4}$" } },
              "requireEach": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z]{1,4}$" } }
            }
          },
          "coverage": { "type": ["string", "null"], "pattern": "^[A-Z]{1,4}$" },
          "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "specialists": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
          "choose": { "type": "string", "minLength": 1 },
          "confirm": { "type": "string", "minLength": 1 },
          "approvalPhrase": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
