{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vais.local/schemas/live-shadow-evidence.schema.json",
  "definitions": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "$ref": "#/definitions/relativePath" },
        "digest": { "$ref": "#/definitions/digest" }
      }
    },
    "v2Run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortId", "scenario", "scale", "repetition", "engine", "sampleClass", "quality", "terminalStatus",
        "instructionTokens", "deliveryCacheCreationTokens", "assuranceCacheCreationTokens",
        "totalCacheCreationTokens", "totalCacheReadTokens", "outputTokens", "elapsedMs", "providerListCost",
        "diagnosticCacheCreationTokens", "formalTurnCount",
        "diagnosticTurnCount", "agentCalls", "requiredAgentCalls", "duplicateAgentCalls", "agentPlanSatisfied",
        "missingRequiredAgentCalls", "independentQaCalls", "agentManifest", "documentCount",
        "authoredDocumentCount", "derivedDocumentCount", "transientDraftCount", "documentBytes",
        "authoredDocumentBytes", "derivedDocumentBytes", "documentManifest", "rawTelemetry", "terminalEvidence",
        "telemetryDigest", "duplicateCheckCount", "checkManifest", "contractRetryCount", "sameErrorRepeatCount",
        "contractManifest", "standaloneReviewProgressTurnCount", "userTurnManifest"
      ],
      "properties": {
        "cohortId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "scenario": { "type": "string", "minLength": 1, "maxLength": 160 },
        "scale": { "enum": ["compact", "standard", "extended"] },
        "repetition": { "type": "integer", "minimum": 1 },
        "engine": { "enum": ["legacy", "v2"] },
        "sampleClass": { "enum": ["formal", "diagnostic"] },
        "quality": { "enum": ["pass", "fail", "blocked"] },
        "terminalStatus": { "enum": ["completed", "paused", "blocked", "failed", "incomplete"] },
        "instructionTokens": { "type": "integer", "minimum": 0 },
        "deliveryCacheCreationTokens": { "type": "integer", "minimum": 0 },
        "assuranceCacheCreationTokens": { "type": "integer", "minimum": 0 },
        "totalCacheCreationTokens": { "type": "integer", "minimum": 0 },
        "totalCacheReadTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "providerListCost": { "type": "number", "minimum": 0 },
        "diagnosticCacheCreationTokens": { "type": "integer", "minimum": 0 },
        "formalTurnCount": { "type": "integer", "minimum": 0 },
        "diagnosticTurnCount": { "type": "integer", "minimum": 0 },
        "agentCalls": { "type": "integer", "minimum": 0 },
        "requiredAgentCalls": { "type": "integer", "minimum": 0 },
        "duplicateAgentCalls": { "type": "integer", "minimum": 0 },
        "missingRequiredAgentCalls": { "type": "integer", "minimum": 0 },
        "independentQaCalls": { "type": "integer", "minimum": 0 },
        "agentPlanSatisfied": { "type": "boolean" },
        "agentManifest": { "$ref": "#/definitions/evidenceRef" },
        "documentCount": { "type": "integer", "minimum": 0 },
        "authoredDocumentCount": { "type": "integer", "minimum": 0 },
        "derivedDocumentCount": { "type": "integer", "minimum": 0 },
        "transientDraftCount": { "type": "integer", "minimum": 0 },
        "documentBytes": { "type": "integer", "minimum": 0 },
        "authoredDocumentBytes": { "type": "integer", "minimum": 0 },
        "derivedDocumentBytes": { "type": "integer", "minimum": 0 },
        "documentManifest": { "$ref": "#/definitions/evidenceRef" },
        "rawTelemetry": { "$ref": "#/definitions/evidenceRef" },
        "terminalEvidence": { "$ref": "#/definitions/evidenceRef" },
        "telemetryDigest": { "$ref": "#/definitions/digest" },
        "duplicateCheckCount": { "type": "integer", "minimum": 0 },
        "checkManifest": { "$ref": "#/definitions/evidenceRef" },
        "contractRetryCount": { "type": "integer", "minimum": 0 },
        "sameErrorRepeatCount": { "type": "integer", "minimum": 0 },
        "contractManifest": { "$ref": "#/definitions/evidenceRef" },
        "standaloneReviewProgressTurnCount": { "type": "integer", "minimum": 0 },
        "userTurnManifest": { "$ref": "#/definitions/evidenceRef" },
        "userTurnCount": { "type": "integer", "minimum": 1 },
        "adapterManifest": { "$ref": "#/definitions/evidenceRef" },
        "qualityObserver": { "$ref": "#/definitions/evidenceRef" }
      }
    },
    "legacyRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario", "repetition", "engine", "quality", "terminalStatus", "instructionTokens", "agentCalls",
        "requiredAgentCalls", "duplicateAgentCalls", "agentPlanSatisfied", "documentCount",
        "authoredDocumentCount", "derivedDocumentCount", "documentBytes", "telemetryDigest"
      ],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "repetition": { "type": "integer", "minimum": 1, "maximum": 3 },
        "engine": { "enum": ["legacy", "v2"] },
        "quality": { "enum": ["pass", "fail", "blocked"] },
        "terminalStatus": { "enum": ["completed", "paused", "blocked", "failed", "incomplete"] },
        "instructionTokens": { "type": "integer", "minimum": 0 },
        "agentCalls": { "type": "integer", "minimum": 0 },
        "requiredAgentCalls": { "type": "integer", "minimum": 0 },
        "duplicateAgentCalls": { "type": "integer", "minimum": 0 },
        "agentPlanSatisfied": { "type": "boolean" },
        "documentCount": { "type": "integer", "minimum": 0 },
        "authoredDocumentCount": { "type": "integer", "minimum": 0 },
        "derivedDocumentCount": { "type": "integer", "minimum": 0 },
        "documentBytes": { "type": "integer", "minimum": 0 },
        "telemetryDigest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "fixture", "runs"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "fixture": { "const": "mini-booking" },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/legacyRun" } }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "fixture", "cohort", "runs"],
      "properties": {
        "schemaVersion": { "enum": ["2.0", "2.1", "2.2"] },
        "fixture": { "const": "mini-booking" },
        "cohort": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "scenario", "stage", "model", "effort", "toolProfile"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 160 },
            "nonce": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
            "scenario": { "type": "string", "minLength": 1, "maxLength": 160 },
            "stage": { "$ref": "#/definitions/evidenceRef" },
            "model": { "type": "string", "minLength": 1, "maxLength": 160 },
            "effort": { "enum": ["low", "medium", "high"] },
            "toolProfile": { "$ref": "#/definitions/evidenceRef" },
            "workload": { "$ref": "#/definitions/evidenceRef" },
            "budgetPolicy": { "enum": ["subscription-no-dollar-cap", "provider-list-cost-cap"] },
            "turnTimeoutMs": { "type": "integer", "minimum": 1 },
            "journeyBudget": { "type": "number", "exclusiveMinimum": 0 },
            "executionOrder": {
              "const": ["legacy:1", "v2:1", "legacy:2", "v2:2", "legacy:3", "v2:3"]
            }
          }
        },
        "runs": { "type": "array", "minItems": 6, "items": { "$ref": "#/definitions/v2Run" } }
      },
      "allOf": [
        {
          "if": { "properties": { "schemaVersion": { "const": "2.1" } } },
          "then": {
            "properties": {
              "cohort": {
                "required": ["id", "scenario", "stage", "model", "effort", "toolProfile", "workload", "journeyBudget", "executionOrder"]
              },
              "runs": {
                "items": { "required": ["adapterManifest", "userTurnCount", "qualityObserver"] }
              }
            }
          }
        },
        {
          "if": { "properties": { "schemaVersion": { "const": "2.2" } } },
          "then": {
            "properties": {
              "cohort": {
                "required": ["id", "nonce", "scenario", "stage", "model", "effort", "toolProfile", "workload", "budgetPolicy", "turnTimeoutMs", "executionOrder"]
              },
              "runs": {
                "items": { "required": ["adapterManifest", "userTurnCount", "qualityObserver"] }
              }
            }
          }
        }
      ]
    }
  ]
}
