{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vais.local/schemas/review-evidence-prepare.schema.json",
  "title": "VAIS v2 Review Evidence Prepare Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "workItemId", "designRevision", "checks", "continuation"],
  "properties": {
    "schema": { "const": "review-evidence-prepare/v1" },
    "id": { "type": "string", "pattern": "^RP-[0-9a-fA-F-]{36}$" },
    "workItemId": { "type": "string", "pattern": "^WI-" },
    "designRevision": { "type": "integer", "minimum": 1 },
    "reviewPage": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "identity", "command", "verdict", "evidencePath", "sourcePhase"],
        "properties": {
          "check": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "identity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "command": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["pass", "fail", "blocked", "missing"] },
          "evidencePath": { "type": ["string", "null"] },
          "sourcePhase": { "type": ["string", "null"], "enum": ["do", "review", null] }
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic", "nextAction", "requiresUserTurn"],
      "properties": {
        "automatic": { "const": true },
        "nextAction": { "const": "independent-qa" },
        "requiresUserTurn": { "const": false }
      }
    }
  }
}
