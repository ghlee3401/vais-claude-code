{
  "name": "vais-code",
  "version": "2.0.4",
  "description": "VAIS — 이력·일관성 개발 워크플로우 (plan/do/review) + brand 스타일 HTML 보고서 생성 — Claude Code Plugin",
  "author": "ghlee3401",
  "license": "MIT",
  "claude-plugin": {
    "skills": [
      "skills/vais/SKILL.md"
    ],
    "agents": [
      "agents/frontend-engineer.md",
      "agents/backend-engineer.md",
      "agents/test-engineer.md",
      "agents/qa-engineer.md",
      "agents/ui-designer.md",
      "agents/incident-responder.md",
      "agents/security-auditor.md"
    ],
    "hooks": [
      "hooks/hooks.json"
    ],
    "outputStyles": "output-styles/vais-default.md"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint scripts/ lib/ hooks/ --max-warnings=0",
    "prepare-hooks": "git config core.hooksPath .hooks"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude-code",
    "claude-plugin",
    "workflow",
    "development",
    "report",
    "vais"
  ]
}
