{
  "name": "vais-code",
  "version": "4.3.0",
  "description": "VAIS Code — 비개발자가 개발자처럼 웹 앱을 만들게 해주는 Claude Code 하네스 플러그인",
  "author": "ghlee3401",
  "license": "MIT",
  "claude-plugin": {
    "skills": [
      "skills/vais/SKILL.md",
      "skills/brief/SKILL.md"
    ],
    "agents": [
      "agents/v2-specialist.md"
    ],
    "hooks": [
      "hooks/hooks.json"
    ],
    "outputStyles": "output-styles/vais-default.md"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "regression": "node --test tests/regression/*.test.js",
    "lint": "eslint scripts/ lib/ hooks/ --max-warnings=0",
    "validate": "node scripts/vais-validate-plugin.js",
    "doctor": "node scripts/vais-doctor.js"
  },
  "dependencies": {
    "ajv": "^6.14.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude-code",
    "claude-plugin",
    "harness",
    "workflow",
    "vais"
  ]
}
